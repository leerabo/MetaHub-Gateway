# MetaHub Gateway 的 OpenAI-compatible 地址；通常需要保留 /v1。
METAHUB_BASE_URL=http://localhost:8000/v1
# 仅填写控制台签发的 Virtual Key，禁止填写 Provider Key。
METAHUB_VIRTUAL_KEY=your-virtual-key
# 填写当前租户已启用的 Chat 模型别名。
METAHUB_CHAT_MODEL=default-chat
# SDK 请求超时，也是流式响应从握手到结束的总时限（秒）。
METAHUB_TIMEOUT_SECONDS=30
# 官方 SDK 在握手前执行的有限自动重试次数。
METAHUB_MAX_RETRIES=2
