# Gateway 的 OpenAI-compatible API 根地址，必须包含 /v1。
METAHUB_BASE_URL=http://localhost:8000/v1

# 仅填写控制台签发的 Virtual Key；不要填写 Provider Key，也不要提交真实值。
METAHUB_VIRTUAL_KEY=your-virtual-key

# 替换为当前租户已启用的模型别名。
METAHUB_CHAT_MODEL=default-chat
METAHUB_EMBEDDING_MODEL=default-embedding

# 请求总超时（秒）与官方客户端自动重试次数。
METAHUB_TIMEOUT_SECONDS=30
METAHUB_MAX_RETRIES=2

