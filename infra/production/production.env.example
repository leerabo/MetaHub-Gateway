# Template only. scripts/deploy/prepare-production.py writes dedicated local secrets.
# Never use the development .env or fixed MFA codes on this deployment.
METAHUB_ENV=prod
METAHUB_VERSION=2.0.0-trial.45
METAHUB_SERVICE_MODE=public_service
METAHUB_PUBLIC_BASE_URL=https://trial.example.com
METAHUB_ALLOWED_ORIGINS=https://trial.example.com
METAHUB_CONTROL_API_BASE_URL=https://control-api:8001
METAHUB_GATEWAY_API_BASE_URL=https://gateway:8000
METAHUB_DATABASE_URL=postgresql://metahub:REPLACE_PASSWORD@postgres:5432/metahub?sslmode=verify-full&sslrootcert=/run/tls/ca.crt
METAHUB_DATABASE_POOL_MIN_SIZE=1
METAHUB_DATABASE_POOL_MAX_SIZE=8
METAHUB_IDENTITY_CHALLENGE_DELIVERY_MODE=disabled
# Configure a real mail relay before enabling smtp. Never use test_capture in production.
METAHUB_SMTP_HOST=
METAHUB_SMTP_PORT=587
METAHUB_SMTP_SECURITY=starttls
METAHUB_SMTP_USERNAME=
METAHUB_SMTP_PASSWORD=
METAHUB_SMTP_SENDER=
METAHUB_SMTP_TIMEOUT_SECONDS=10
METAHUB_DEV_PLATFORM_NO_MFA=false
METAHUB_PLATFORM_BOOTSTRAP_ENABLED=false
METAHUB_KMS_PROVIDER=disabled
METAHUB_BACKUP_WORKER_ENABLED=false
METAHUB_MCP_ENABLED=false
METAHUB_MCP_EXECUTOR_MODE=disabled
METAHUB_MCP_SCHEDULER_ENABLED=false
METAHUB_BATCH_WORKER_ENABLED=false
METAHUB_RESPONSE_CACHE_ENABLED=false
METAHUB_SESSION_RISK_ENABLED=false
METAHUB_POLICY_SNAPSHOT_SYNC_ENABLED=true
METAHUB_LOG_LEVEL=INFO
METAHUB_UPDATE_QUEUE_DIR=/run/system-update
SSL_CERT_FILE=/run/tls/ca.crt
REQUESTS_CA_BUNDLE=/run/tls/ca.crt
# Each required secret is generated individually. When migrating existing encrypted
# data, preserve the original encryption roots; do not generate replacement roots.
