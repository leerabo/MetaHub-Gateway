{
  "profile_id": "local-sqlite",
  "project_name": "metahub",
  "database_mode": "sqlite",
  "env_file": "infra/compose/.env.compose",
  "services": {
    "gateway": { "enabled": true, "port": 8000, "health": "/health/live" },
    "control-api": { "enabled": true, "port": 8001, "health": "/health/live" },
    "console": { "enabled": true, "port": 5173, "health": "/" },
    "redis": { "enabled": false, "port": 6379 },
    "postgres": { "enabled": false, "port": 5432 },
    "minio": { "enabled": false, "port": 9000 }
  },
  "volumes": {
    "sqlite": "metahub-sqlite",
    "logs": "metahub-logs"
  }
}
