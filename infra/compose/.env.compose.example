# MetaHub single-node Compose environment template.
# This tracked file contains unusable placeholders only. install.ps1 creates
# infra/compose/.env.compose and replaces every secret with an independent value.

METAHUB_ENV=dev
METAHUB_LOG_LEVEL=INFO
METAHUB_SERVICE_MODE=internal_only
METAHUB_DATABASE_URL=sqlite:///./.data/compose/metahub.db
# compose-full production-parity example (TLS termination is required outside local Compose):
# METAHUB_DATABASE_URL=postgresql://metahub:replace-me@postgres:5432/metahub
METAHUB_REDIS_URL=redis://redis:6379/0
METAHUB_DATABASE_POOL_MIN_SIZE=1
METAHUB_DATABASE_POOL_MAX_SIZE=10
METAHUB_DATABASE_POOL_TIMEOUT_SECONDS=3
METAHUB_DATABASE_STATEMENT_TIMEOUT_MS=30000
METAHUB_DATABASE_LOCK_TIMEOUT_MS=5000
METAHUB_OBJECT_STORE_ENDPOINT_URL=http://minio:9000
METAHUB_OBJECT_STORE_REGION=us-east-1
METAHUB_OBJECT_STORE_BUCKET=metahub-backups
METAHUB_KMS_PROVIDER=test
METAHUB_KMS_TEST_MASTER_KEY=replace-with-generated-kms-test-master-key
METAHUB_GATEWAY_API_BASE_URL=http://gateway:8000
METAHUB_CONTROL_API_BASE_URL=http://control-api:8001
METAHUB_ALLOWED_ORIGINS=http://localhost:5173

# Independent server-side secret domains. Never reuse one generated value in
# another field and never commit the generated .env.compose file.
METAHUB_INTERNAL_CONFIG_TOKEN=replace-with-generated-internal-config-token
METAHUB_INTERNAL_CHAT_TOKEN=replace-with-generated-internal-chat-token
METAHUB_INTERNAL_BATCH_TOKEN=replace-with-generated-internal-batch-token
METAHUB_AUTH_TOKEN_SECRET=replace-with-generated-auth-token-secret
METAHUB_PROVIDER_KEY_ENCRYPTION_SECRET=replace-with-generated-provider-encryption-secret
METAHUB_PROMPT_TEMPLATE_ENCRYPTION_SECRET=replace-with-generated-prompt-template-secret
METAHUB_FILE_ENCRYPTION_SECRET=replace-with-generated-file-encryption-secret
METAHUB_BATCH_ENCRYPTION_SECRET=replace-with-generated-batch-encryption-secret
METAHUB_MCP_ENCRYPTION_SECRET=replace-with-generated-mcp-encryption-secret
METAHUB_MCP_HMAC_SECRET=replace-with-generated-mcp-hmac-secret
METAHUB_MCP_SANDBOX_INTERNAL_TOKEN=replace-with-generated-mcp-sandbox-internal-token
METAHUB_MCP_SANDBOX_ENVELOPE_SECRET=replace-with-generated-mcp-sandbox-envelope-secret
METAHUB_MCP_SANDBOX_PERMIT_SECRET=replace-with-generated-mcp-sandbox-permit-secret
METAHUB_MCP_SANDBOX_RESPONSE_SECRET_CURRENT=replace-with-generated-mcp-sandbox-response-secret
METAHUB_CACHE_AFFINITY_HMAC_SECRET=replace-with-generated-cache-affinity-secret
METAHUB_SESSION_RISK_HMAC_SECRET=replace-with-generated-session-hmac-secret
METAHUB_APPROVAL_HMAC_SECRET=replace-with-generated-approval-hmac-secret
METAHUB_RESPONSE_CACHE_HMAC_SECRET=replace-with-generated-response-cache-hmac-secret
METAHUB_RESPONSE_CACHE_ENCRYPTION_SECRET=replace-with-generated-response-cache-encryption-secret
METAHUB_RESPONSE_CACHE_CONTROL_IDEMPOTENCY_SECRET=replace-with-generated-response-cache-control-secret
METAHUB_RESPONSE_CACHE_FAILURE_SPOOL_SECRET=replace-with-generated-response-cache-spool-secret
METAHUB_SESSION_RISK_HMAC_VERSION=1
METAHUB_APPROVAL_HMAC_VERSION=1
METAHUB_APPROVAL_SCHEDULER_ENABLED=true
METAHUB_APPROVAL_SCHEDULER_POLL_INTERVAL_SECONDS=2
METAHUB_APPROVAL_SCHEDULER_BATCH_SIZE=50
METAHUB_APPROVAL_OUTBOX_ENABLED=true
METAHUB_APPROVAL_OUTBOX_POLL_INTERVAL_SECONDS=2
METAHUB_APPROVAL_OUTBOX_BATCH_SIZE=50
METAHUB_APPROVAL_WRITEBACK_ENABLED=true
METAHUB_APPROVAL_WRITEBACK_POLL_INTERVAL_SECONDS=2
METAHUB_APPROVAL_WRITEBACK_BATCH_SIZE=50
METAHUB_SESSION_RISK_ENABLED=false

# MCP Control, dedicated Scheduler, and isolated Sandbox share only the
# non-sensitive caps below. Compose overrides role-specific mode and secrets.
METAHUB_MCP_ENABLED=true
METAHUB_MCP_ENCRYPTION_VERSION=1
METAHUB_MCP_HMAC_VERSION=1
METAHUB_MCP_SCHEDULER_ENABLED=false
METAHUB_MCP_EXECUTOR_MODE=disabled
METAHUB_MCP_SANDBOX_BASE_URL=http://mcp-sandbox:8091
METAHUB_MCP_SANDBOX_RESPONSE_KEY_VERSION=1
METAHUB_MCP_SANDBOX_RESPONSE_SECRET_PREVIOUS=
METAHUB_MCP_NETWORK_CONNECT_TIMEOUT_MAX_SECONDS=5
METAHUB_MCP_NETWORK_PROBE_TIMEOUT_MAX_SECONDS=10
METAHUB_MCP_NETWORK_CALL_TIMEOUT_MAX_SECONDS=30
METAHUB_MCP_NETWORK_FAILURE_THRESHOLD_MAX=10
METAHUB_MCP_NETWORK_OPEN_SECONDS_MAX=3600
METAHUB_MCP_SANDBOX_PRIVATE_CIDRS=
METAHUB_MCP_SANDBOX_DENY_CIDRS=
METAHUB_MCP_SANDBOX_ALLOWED_PORTS=443
METAHUB_MCP_SANDBOX_DENY_PORTS=1433,1521,2049,2375,2376,3306,5432,5984,6379,6443,8020,8500,9000,9042,9200,11211,27017
METAHUB_MCP_SANDBOX_DNS_TIMEOUT_SECONDS=2
METAHUB_MCP_SANDBOX_TLS_TIMEOUT_SECONDS=5
METAHUB_MCP_SANDBOX_HEADERS_TIMEOUT_SECONDS=10
METAHUB_MCP_SANDBOX_BODY_IDLE_TIMEOUT_SECONDS=10
METAHUB_MCP_SANDBOX_MAX_DNS_ANSWERS=8
METAHUB_MCP_SANDBOX_MAX_ACTIVE_SESSIONS=16
METAHUB_MCP_SANDBOX_CLEANUP_TIMEOUT_SECONDS=2

METAHUB_FILE_STORAGE_ROOT=.data/compose/file-storage
METAHUB_FINOPS_USAGE_SPOOL_ROOT=.data/compose/finops-usage-spool
METAHUB_POLICY_SNAPSHOT_SYNC_ENABLED=true
METAHUB_PROVIDER_ERROR_MAP_SYNC_ENABLED=false
METAHUB_PROVIDER_HEALTH_ENABLED=false
METAHUB_BATCH_WORKER_ENABLED=true
METAHUB_BATCH_POLL_INTERVAL_SECONDS=1
METAHUB_BATCH_GLOBAL_CONCURRENCY=2
METAHUB_BATCH_TENANT_CONCURRENCY=1
METAHUB_BATCH_LEASE_SECONDS=90
METAHUB_BATCH_HEARTBEAT_SECONDS=30
METAHUB_BATCH_GATEWAY_CONCURRENCY=1
METAHUB_BATCH_REALTIME_COOLDOWN_MILLISECONDS=250
METAHUB_BATCH_REALTIME_RESERVE_PERCENT=25
METAHUB_BATCH_MAX_PENDING_JOBS_PER_TENANT=100
METAHUB_BATCH_MAX_PENDING_TASKS_PER_TENANT=10000
METAHUB_BATCH_MAX_RESULT_BYTES=1048576
METAHUB_EXPERIMENT_SCHEDULER_INTERVAL_SECONDS=5
METAHUB_EXPERIMENT_FINALIZER_LEASE_SECONDS=90
METAHUB_EXPERIMENT_EXECUTION_LEASE_SECONDS=90
METAHUB_EXPERIMENT_EXECUTION_HEARTBEAT_SECONDS=20
METAHUB_EXPERIMENT_SCHEDULER_BATCH_LIMIT=20
METAHUB_EXPERIMENT_EXECUTION_MAX_SECONDS=3600
METAHUB_EXPERIMENT_SETTLEMENT_GRACE_SECONDS=3600
# Response Cache 在单机 profile 中同样默认关闭；启用和轮换必须走停服维护门禁。
METAHUB_RESPONSE_CACHE_ENABLED=false
METAHUB_RESPONSE_CACHE_HMAC_VERSION=1
METAHUB_RESPONSE_CACHE_ENCRYPTION_VERSION=1
METAHUB_RESPONSE_CACHE_CONTROL_IDEMPOTENCY_VERSION=1
METAHUB_RESPONSE_CACHE_FAILURE_SPOOL_VERSION=1
METAHUB_RESPONSE_CACHE_MAX_READY_ENTRIES_PER_TENANT=10000
METAHUB_RESPONSE_CACHE_MAX_PLAINTEXT_BYTES=1048576
METAHUB_RESPONSE_CACHE_FILL_LEASE_SECONDS=90
METAHUB_RESPONSE_CACHE_FAILURE_SPOOL_ROOT=.data/compose/response-cache-failure-spool
METAHUB_RESPONSE_CACHE_FAILURE_SPOOL_POLL_INTERVAL_SECONDS=2
METAHUB_RESPONSE_CACHE_FAILURE_SPOOL_CLAIM_LEASE_SECONDS=60
# 只读管理助手事件 source 默认恢复投递；关闭只暂停 drain，不跳过审计事实写入。
METAHUB_ADMIN_ASSISTANT_EVENT_ENABLED=true
METAHUB_ADMIN_ASSISTANT_EVENT_POLL_INTERVAL_SECONDS=2

# Seed values are generated local bootstrap credentials, not production keys.
METAHUB_SEED_ADMIN_EMAIL=admin@metahub.local
METAHUB_SEED_ADMIN_PASSWORD=replace-with-generated-admin-password
METAHUB_SEED_PROVIDER_API_KEY=replace-with-generated-provider-placeholder
METAHUB_SEED_VIRTUAL_KEY=replace-with-generated-virtual-key

# Loopback service exposure.
METAHUB_GATEWAY_BIND=127.0.0.1
METAHUB_GATEWAY_PORT=8000
METAHUB_CONTROL_BIND=127.0.0.1
METAHUB_CONTROL_PORT=8001
METAHUB_CONSOLE_BIND=127.0.0.1
METAHUB_CONSOLE_PORT=5173

# Optional compose-full infrastructure remains loopback-only.
METAHUB_REDIS_BIND=127.0.0.1
METAHUB_REDIS_PORT=6379
METAHUB_POSTGRES_BIND=127.0.0.1
METAHUB_POSTGRES_PORT=5432
METAHUB_POSTGRES_DB=metahub
METAHUB_POSTGRES_USER=metahub
METAHUB_POSTGRES_PASSWORD=replace-with-generated-postgres-password
METAHUB_MINIO_BIND=127.0.0.1
METAHUB_MINIO_PORT=9000
METAHUB_MINIO_CONSOLE_BIND=127.0.0.1
METAHUB_MINIO_CONSOLE_PORT=9001
METAHUB_MINIO_ACCESS_KEY=replace-with-generated-minio-access-key
METAHUB_MINIO_SECRET_KEY=replace-with-generated-minio-secret-key

METAHUB_IMAGE_PREFIX=metahub
METAHUB_IMAGE_TAG=local
METAHUB_VERSION=0.1.0-dev
METAHUB_BUILD_COMMIT=unknown
METAHUB_BUILD_TIME=unknown
