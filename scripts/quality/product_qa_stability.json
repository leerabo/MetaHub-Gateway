{
  "schema": "metahub.product-qa.stability-config.v1",
  "targets": [
    "control=http://127.0.0.1:8001/health",
    "gateway=http://127.0.0.1:8000/health",
    "console=http://127.0.0.1:5173/"
  ],
  "profiles": {
    "short_stability": {
      "requests": 100000,
      "concurrency": 4,
      "duration_seconds": 8,
      "timeout_seconds": 3,
      "request_interval_seconds": 0,
      "observation_bucket_seconds": 1,
      "minimum_observed_seconds": 7,
      "maximum_observation_gap_seconds": 10
    },
    "long_stability": {
      "requests": 1000000,
      "concurrency": 4,
      "duration_seconds": 14400,
      "timeout_seconds": 5,
      "request_interval_seconds": 0.5,
      "observation_bucket_seconds": 10,
      "minimum_observed_seconds": 14000,
      "maximum_observation_gap_seconds": 10
    }
  }
}
