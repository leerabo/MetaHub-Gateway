# MetaHub AI Gateway local environment template
#
# PRD-001 只启用服务空壳、健康检查和版本接口。
# 不要在该文件中写入真实 Provider Key、Virtual Key、数据库密码或任何客户密钥。

METAHUB_ENV=dev
METAHUB_LOG_LEVEL=INFO

# Local service URLs
METAHUB_GATEWAY_API_BASE_URL=http://localhost:8000
METAHUB_CONTROL_API_BASE_URL=http://localhost:8001
METAHUB_ALLOWED_ORIGINS=http://localhost:5173

# PRD-064 Provider Adapter 契约 runner 的受信部署绑定。下面三项不是密钥，但必须由部署环境
# 独立下发；probe JSON、CLI 参数和报告正文都不能自行声明或覆盖这些可信事实。生产环境只允许
# HTTPS；本地 HTTP 仅限 loopback，并且仍需在 probe/wrapper 中显式开启 loopback 开关。
METAHUB_CONTRACT_TRUSTED_GATEWAY_ORIGIN=http://localhost:8000
METAHUB_CONTRACT_TRUSTED_CONTROL_ORIGIN=http://localhost:8001
METAHUB_CONTRACT_TRUSTED_TENANT_ID=default
# mock 合并门禁可单独指定报告租户；真实 probe 仍以受信租户和 Virtual Key 实际 owner 为准。
METAHUB_CONTRACT_TENANT_ID=default
# 配置该项才启用报告上报；值必须与受信 Control origin 完全同源。
# METAHUB_CONTRACT_CONTROL_URL=http://localhost:8001
# probe 配置的 virtual_key_env 应指向单独注入的变量，真实值不得提交到仓库或写入日志/报告。
# METAHUB_CONTRACT_PROBE_VIRTUAL_KEY=replace-with-tenant-virtual-key

# Optional profile file. Priority: defaults < .env < METAHUB_CONFIG_FILE < environment variables.
# METAHUB_CONFIG_FILE=config/dev.env

# Service mode: internal_only is the MVP default; public_service is reserved for future compliance mode.
METAHUB_SERVICE_MODE=internal_only

# Internal endpoint protection. Local sample value is intentionally non-production and must be
# replaced before exposure; Control and Gateway policy snapshot sync must use the same token.
METAHUB_INTERNAL_CONFIG_TOKEN=metahub-local-policy-sync-2026-change-before-production-7f4c2a91

# Local admin authentication. Change the token secret before exposing any non-local environment.
METAHUB_AUTH_TOKEN_SECRET=replace-with-auth-token-secret
# Prompt 模板正文、变量 schema 和变更说明使用独立 AES-GCM 根密钥；Control 与 Gateway 必须一致，
# 且禁止复用 Auth、Provider、Webhook 或 Cache Affinity 密钥。
METAHUB_PROMPT_TEMPLATE_ENCRYPTION_SECRET=replace-with-independent-prompt-template-secret-at-least-32-characters
# PRD-072 原文件、抽取正文和文件名使用独立 AES-GCM/HMAC 根密钥；生产环境会拒绝该
# 示例值、弱值以及与 Auth、Provider、Prompt 或 Cache 密钥复用的值。对象根目录只保存密文，
# 不得配置为网络共享、文件系统根或符号链接；上传上限范围 1..50 MiB，并发范围 1..8。
METAHUB_FILE_ENCRYPTION_SECRET=replace-with-independent-file-encryption-secret-at-least-32-characters
METAHUB_FILE_STORAGE_ROOT=.data/file-storage
METAHUB_FILE_MAX_UPLOAD_BYTES=20971520
METAHUB_FILE_PARSE_CONCURRENCY=2
# PRD-073 文件安全扫描与 OCR 使用独立并发池；所有值都是部署级硬上限，API 请求不能覆盖。
# OCR 完全离线，生产镜像必须预装 RapidOCR 模型，初始化或覆盖不足时模型准入失败关闭。
METAHUB_FILE_SECURITY_SCAN_CONCURRENCY=2
METAHUB_FILE_SECURITY_OCR_CONCURRENCY=1
METAHUB_FILE_SECURITY_MAX_OCR_PAGES=20
METAHUB_FILE_SECURITY_MAX_IMAGES=50
METAHUB_FILE_SECURITY_MAX_IMAGE_PIXELS=12000000
METAHUB_FILE_SECURITY_MAX_TOTAL_PIXELS=50000000
# PRD-074 Batch Worker uses independent service and encryption domains. Production must replace
# both values and must not reuse Config/Chat/Auth/Provider/File/Prompt/Cache/Session secrets.
METAHUB_INTERNAL_BATCH_TOKEN=replace-with-independent-internal-batch-token-at-least-32-characters
METAHUB_BATCH_ENCRYPTION_SECRET=replace-with-independent-batch-encryption-secret-at-least-32-characters
METAHUB_BATCH_WORKER_ENABLED=false
METAHUB_BATCH_POLL_INTERVAL_SECONDS=1
METAHUB_BATCH_GLOBAL_CONCURRENCY=2
METAHUB_BATCH_TENANT_CONCURRENCY=1
METAHUB_BATCH_LEASE_SECONDS=90
METAHUB_BATCH_HEARTBEAT_SECONDS=30
METAHUB_BATCH_GATEWAY_CONCURRENCY=1
METAHUB_BATCH_REALTIME_COOLDOWN_MILLISECONDS=250
METAHUB_BATCH_REALTIME_RESERVE_PERCENT=25
METAHUB_BATCH_MAX_PENDING_JOBS_PER_TENANT=100
METAHUB_BATCH_MAX_PENDING_TASKS_PER_TENANT=10000
METAHUB_BATCH_MAX_RESULT_BYTES=1048576
# PRD-075 online experiment scheduler/execution bounds. These are non-sensitive deployment
# controls; active experiments still reuse the existing Auth root through strict HMAC domains.
METAHUB_EXPERIMENT_SCHEDULER_INTERVAL_SECONDS=5
METAHUB_EXPERIMENT_FINALIZER_LEASE_SECONDS=90
METAHUB_EXPERIMENT_EXECUTION_LEASE_SECONDS=90
METAHUB_EXPERIMENT_EXECUTION_HEARTBEAT_SECONDS=20
METAHUB_EXPERIMENT_SCHEDULER_BATCH_LIMIT=20
METAHUB_EXPERIMENT_EXECUTION_MAX_SECONDS=3600
METAHUB_EXPERIMENT_SETTLEMENT_GRACE_SECONDS=3600
# Prompt Cache affinity uses an independent HMAC domain. Production Gateway rejects this sample,
# the authentication secret, default values, and secrets shorter than 32 characters.
METAHUB_CACHE_AFFINITY_HMAC_SECRET=replace-with-cache-affinity-hmac-secret-at-least-32-characters
# PRD-070 多轮会话风险默认关闭；启用时 Gateway 与 Control 必须使用同一把独立 HMAC key。
# 该 key 只派生 tenant/Virtual Key 限定的会话与幂等摘要，禁止复用 Auth、Prompt、Provider
# 或 Cache Affinity Secret。轮换期间 previous 必须版本/Secret 成对配置，确认无引用后再删除。
METAHUB_SESSION_RISK_ENABLED=false
METAHUB_SESSION_RISK_HMAC_VERSION=2
METAHUB_SESSION_RISK_HMAC_SECRET=replace-with-independent-session-risk-hmac-secret-at-least-32-characters
# METAHUB_SESSION_RISK_PREVIOUS_HMAC_VERSION=1
# METAHUB_SESSION_RISK_PREVIOUS_HMAC_SECRET=replace-with-retained-previous-session-risk-hmac-secret
METAHUB_SESSION_TTL_SECONDS=28800
METAHUB_LOGIN_MAX_FAILURES=5
METAHUB_LOGIN_LOCK_SECONDS=900
METAHUB_DEFAULT_TENANT_SLUG=default

# Optional infrastructure endpoints. Keep real credentials out of git.
METAHUB_DATABASE_URL=postgresql://user:password@localhost:5432/metahub
# Local runnable fallback for PRD-003 without PostgreSQL driver:
# METAHUB_DATABASE_URL=sqlite:///./.data/metahub.db
METAHUB_REDIS_URL=redis://localhost:6379/0
# FinOps Usage 在主库暂时不可写时只把安全白名单字段落到本机专属目录；不得配置网络盘、
# junction/symlink 或多人共享目录。HMAC 使用服务端认证密钥的独立业务域。
METAHUB_FINOPS_USAGE_SPOOL_ROOT=.data/finops-usage-spool
# 周期扫描保持有界；claim 只有超过租期才允许由其他 Gateway worker 恢复。
METAHUB_FINOPS_USAGE_SPOOL_POLL_INTERVAL_SECONDS=2
METAHUB_FINOPS_USAGE_SPOOL_CLAIM_LEASE_SECONDS=60

# Provider connection placeholders. OpenRouter and SiliconFlow are benchmark/migration targets,
# not the default upstream provider.
METAHUB_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
METAHUB_PROVIDER_DEEPSEEK_API_KEY=replace-with-provider-key
METAHUB_PROVIDER_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
METAHUB_PROVIDER_ZHIPU_API_KEY=replace-with-provider-key

# Provider 健康周期探测。私网 Endpoint 必须显式配置 CIDR allowlist，默认拒绝回环和 metadata 地址。
METAHUB_PROVIDER_HEALTH_ENABLED=true
METAHUB_PROVIDER_HEALTH_INTERVAL_SECONDS=60
METAHUB_PROVIDER_HEALTH_TIMEOUT_SECONDS=5
METAHUB_PROVIDER_HEALTH_FAILURE_THRESHOLD=3
METAHUB_PROVIDER_HEALTH_LEASE_SECONDS=20
METAHUB_PROVIDER_HEALTH_STALE_SECONDS=180
METAHUB_PROVIDER_HEALTH_CONCURRENCY=1
# METAHUB_PROVIDER_HEALTH_PRIVATE_CIDRS=10.20.0.0/16,192.168.50.0/24

# Usage CSV 导出。硬上限和短 lease 防止宽查询、长期 BLOB 或失联 worker 无界占用资源。
METAHUB_USAGE_EXPORT_ENABLED=true
METAHUB_USAGE_EXPORT_POLL_INTERVAL_SECONDS=2
METAHUB_USAGE_EXPORT_SYNC_ROW_LIMIT=5000
METAHUB_USAGE_EXPORT_MAX_ROWS=100000
METAHUB_USAGE_EXPORT_MAX_BYTES=52428800
METAHUB_USAGE_EXPORT_LEASE_SECONDS=60
METAHUB_USAGE_EXPORT_MAX_ATTEMPTS=3
METAHUB_USAGE_EXPORT_RETENTION_HOURS=24

# RequestExplanation 查看事件 source outbox。默认开启，仅做 tenant-safe 单行领取与恢复。
# poll 只允许 1..60 秒；关闭只暂停投递，不删除已提交访问事实或 pending 事件。
METAHUB_REQUEST_EXPLANATION_EVENT_ENABLED=true
METAHUB_REQUEST_EXPLANATION_EVENT_POLL_INTERVAL_SECONDS=2

# RequestLog QueryEvent source outbox。与查看事件独立启停，默认开启并只扫描 0045 的索引状态。
# poll 只允许 1..60 秒；关闭只暂停异步投递，不删除已提交查询事实或 pending 事件。
METAHUB_REQUEST_LOG_QUERY_EVENT_ENABLED=true
METAHUB_REQUEST_LOG_QUERY_EVENT_POLL_INTERVAL_SECONDS=2

# 成本异常检测默认关闭；检测只读取正式 FinOps Usage Charge，阈值使用整数微元/毫倍数。
# poll 允许 5..300 秒，multiplier 允许 1001..100000，最低金额允许 1..1000000000000 micros。
METAHUB_COST_ANOMALY_ENABLED=false
METAHUB_COST_ANOMALY_POLL_INTERVAL_SECONDS=30
METAHUB_COST_ANOMALY_SPIKE_MULTIPLIER_MILLIS=5000
METAHUB_COST_ANOMALY_MIN_COST_MICROS=10000
# 工作时段使用 Asia/Shanghai 的 0..23 小时，且 start 必须严格小于 end。
METAHUB_COST_ANOMALY_WORKDAY_START_HOUR=9
METAHUB_COST_ANOMALY_WORKDAY_END_HOUR=18

# 策略 DSL 整组求值预算。只允许 1-100 ms；超时固定拒绝并要求调用方告警。
METAHUB_POLICY_EVALUATION_TIMEOUT_MS=5

# PRD-068 输入脱敏运行能力门禁。默认关闭，只有 Gateway 的 policy-mask-v1 自检通过且
# Control 与 Gateway 使用同一部署配置时才可开启；该开关不包含密钥或任何客户数据。
METAHUB_POLICY_MASK_RUNTIME_ENABLED=false

# 策略快照轮询与 LKG 保护。生产/public_service 不允许关闭同步；HTTP 只限本地回环开发。
METAHUB_POLICY_SNAPSHOT_SYNC_ENABLED=true
METAHUB_POLICY_SNAPSHOT_POLL_INTERVAL_SECONDS=2
METAHUB_POLICY_SNAPSHOT_HTTP_TIMEOUT_SECONDS=2
METAHUB_POLICY_SNAPSHOT_MAX_AGE_SECONDS=300
METAHUB_POLICY_SNAPSHOT_EMERGENCY_MAX_AGE_SECONDS=3600
METAHUB_POLICY_SNAPSHOT_MAX_PAYLOAD_BYTES=4194304

# Provider 错误映射独立热更新。旧部署默认关闭；生产验收开启时复用内部 Token 拉取租户快照。
METAHUB_PROVIDER_ERROR_MAP_SYNC_ENABLED=false
METAHUB_PROVIDER_ERROR_MAP_POLL_INTERVAL_SECONDS=2
METAHUB_PROVIDER_ERROR_MAP_HTTP_TIMEOUT_SECONDS=2
METAHUB_PROVIDER_ERROR_MAP_REFRESH_QUEUE_TIMEOUT_SECONDS=2
METAHUB_PROVIDER_ERROR_MAP_FRESH_SECONDS=300
METAHUB_PROVIDER_ERROR_MAP_LKG_SECONDS=3600
METAHUB_PROVIDER_ERROR_MAP_MAX_PAYLOAD_BYTES=262144
METAHUB_PROVIDER_ERROR_MAP_REFRESH_CONCURRENCY=4

# 输出侧安全检测边界。interval 允许 8..256，window 允许 32..1024 且必须不小于 interval；
# 非流式全文上限不得超过 262144 code points，任何租户请求都不能覆盖这些部署值。
METAHUB_OUTPUT_SAFETY_INTERVAL_TOKENS=32
METAHUB_OUTPUT_SAFETY_WINDOW_TOKENS=256
METAHUB_OUTPUT_SAFETY_MAX_FULL_TEXT_CODE_POINTS=262144

# Seed data placeholders. Password and keys are never stored in plaintext.
METAHUB_SEED_ADMIN_EMAIL=admin@metahub.local
METAHUB_SEED_ADMIN_PASSWORD=replace-with-local-admin-password
METAHUB_SEED_PROVIDER_API_KEY=replace-with-local-provider-key
METAHUB_SEED_VIRTUAL_KEY=mhv_dev_seed_virtual_key

# Build metadata shown by /version
METAHUB_VERSION=0.1.0-dev
METAHUB_BUILD_COMMIT=unknown
METAHUB_BUILD_TIME=unknown
